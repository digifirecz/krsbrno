# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MariaDB / MySQL connection string.
# Local dev (Homebrew mariadb): mysql://krsbrno:krsbrno@127.0.0.1:3306/krsbrno
# Wedos VPS: mysql://<user>:<pass>@127.0.0.1:3306/<db>
DATABASE_URL="mysql://krsbrno:krsbrno@127.0.0.1:3306/krsbrno"

# Podepisuje session cookie přihlášení. Vygeneruj: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME"

# Volitelné — e-maily pro reset hesla. Bez RESEND_API_KEY i SMTP_HOST se odkaz
# jen zaloguje do konzole serveru (dobré pro lokální vývoj).
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Křesťanský sbor Brno <noreply@krsbrno.cz>"
