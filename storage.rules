rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /pages/{pageId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /articles/{articleId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /social/{groupId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /branding/{groupId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
