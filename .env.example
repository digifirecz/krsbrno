# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Postgres connection string — use the "Transaction pooler" string
# from Project Settings → Database (port 6543), NOT the direct connection
# (port 5432). The pooler is required for this to work on Vercel, where each
# serverless invocation can open its own connection.
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres"

# Project Settings → API. SUPABASE_SERVICE_ROLE_KEY bypasses all access
# control — server-only, must never reach client-side code or a NEXT_PUBLIC_
# variable. Used only by lib/supabaseAdmin.ts (file uploads).
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"

# Podepisuje session cookie přihlášení. Vygeneruj: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME"

# Volitelné — e-maily pro reset hesla. Bez RESEND_API_KEY i SMTP_HOST se odkaz
# jen zaloguje do konzole serveru (dobré pro lokální vývoj).
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Křesťanský sbor Brno <noreply@krsbrno.cz>"

# Error tracking (Sentry) — DSN is public by design (safe in the browser bundle).
# Project Settings → Manual Configuration on sentry.io.
NEXT_PUBLIC_SENTRY_DSN=""
