# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MariaDB / MySQL connection string.
# Local dev (Homebrew mariadb): mysql://krsbrno:krsbrno@127.0.0.1:3306/krsbrno
# Wedos VPS: mysql://<user>:<pass>@127.0.0.1:3306/<db>
DATABASE_URL="mysql://krsbrno:krsbrno@127.0.0.1:3306/krsbrno"
